{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thanhuydiet207-a11y/Sentinel-Code/blob/main/schemas/security-findings.schema.json",
  "title": "Sentinel-Code Security Findings",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metadata": {"type": "object"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "rule_id", "category", "severity", "confidence", "location", "evidence", "impact", "remediation"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "category": {"type": "string", "pattern": "^(CWE-[0-9]{1,5}|OWASP-A[0-9]{2}|custom:[a-z0-9._-]{1,64})$"},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "location": {
          "type": "object", "required": ["path", "start_line", "end_line"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "start_line": {"type": "integer", "minimum": 1},
            "end_line": {"type": "integer", "minimum": 1}
          }
        },
        "evidence": {
          "type": "object", "required": ["reason", "line_hash"],
          "properties": {
            "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
            "line_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "data_flow": {"type": "array", "items": {"type": "string"}}
          }
        },
        "impact": {"type": "string", "minLength": 1, "maxLength": 2000},
        "remediation": {"type": "string", "minLength": 1, "maxLength": 3000},
        "references": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
